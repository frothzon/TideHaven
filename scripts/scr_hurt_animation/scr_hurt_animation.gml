function scr_hurt_animation(){
	image_speed = 1;
	animator = [
		/// right
		char_hit_right_anim,
		/// up
		char_hit_up_anim,
		/// left
		char_hit_left_anim,
		/// down
		char_hit_down_anim
	];
}