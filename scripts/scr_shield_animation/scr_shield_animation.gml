function scr_shield_animation(){
	animator = [
		/// right
		char_shielded_hit_right_anim,
		/// up
		char_shielded_hit_up_anim,
		/// left
		char_shielded_hit_left_anim,
		/// down
		char_shielded_hit_down_anim
	];
}